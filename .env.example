# Domain produksi untuk canonical, Open Graph, dan sitemap di masa depan.
NEXT_PUBLIC_SITE_URL=https://jejakbaik.my.id

# Kunci klien OAuth Google untuk tombol "Lanjutkan dengan Google".
# Cara mengisi:
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Create credentials -> OAuth client ID -> Web application
# 3. Authorized JavaScript origins: isi alamat situs tanpa garis miring di akhir,
#    misalnya http://20.2.218.98 dan https://domainmu.example
# 4. Salin Client ID (berakhiran .apps.googleusercontent.com) ke bawah ini.
# Nilai ini memang publik (dikirim ke peramban). Jangan taruh client secret di sini.
# Kosongkan kalau belum ada: tombol Google tidak muncul dan profil manual tetap jalan.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# URL Web App Apps Script untuk Google Sheets (berakhiran /exec).
# Cara membuatnya ada di docs/SETUP-GOOGLE-SHEET.md.
# Kosongkan kalau belum ada: laporan dan pendaftaran Guru BK kembali tersimpan
# di peramban saja, dan panel admin tidak aktif.
NEXT_PUBLIC_SHEET_API_URL=
